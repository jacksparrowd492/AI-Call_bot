# ---- Twilio (required) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

PUBLIC_BASE_URL=

# ---- Deepgram (required) ----
DEEPGRAM_API_KEY=
# --- STT (Speech-to-Text) Settings ---
DEEPGRAM_MODEL=nova-2
# Silence that ends a PHRASE. Raise if the bot still clips people mid-sentence.
DEEPGRAM_ENDPOINTING_MS=900
# Silence that ends the TURN - this is what actually triggers a reply.
UTTERANCE_END_MS=1400
# Extra wait after a phrase ends, in case the caller is only pausing to think.
TURN_DEBOUNCE_MS=700
# Transcripts below this confidence are treated as noise, not speech.
STT_MIN_CONFIDENCE=0.55
# Mic stays shut this long after the bot's audio finishes playing (anti-echo).
ECHO_TAIL_MS=700
# --- TTS (Text-to-Speech) Settings ---
DEEPGRAM_TTS_MODEL=aura-asteria-en

# ---- Groq LLM (required) ----
GROQ_API_KEY=
# A reasoning model (openai/gpt-oss-120b) burned the token budget on hidden
# reasoning and kept tripping Groq's rate limit - 9s of dead air per retry.
# Verified against this key with `python tools/check_groq.py` - it carries no
# llama models at all. qwen3.8 is the newest general instruct model on it;
# thinking is switched off below because the caller never hears it.
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b
QWEN_REASONING_EFFORT=none
LLM_MAX_TOKENS=400

# # ---- ElevenLabs TTS (required) ----
# ELEVENLABS_API_KEY=
# ELEVEN_VOICE_ID=
# ELEVEN_MODEL_ID=eleven_turbo_v2_5

# ---- WhatsApp brochure (optional until feature is enabled) ----
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
BROCHURE_URL=https://your-host.example/brochure.pdf

# ---- Human handoff (optional until feature is enabled) ----
AGENT_DIAL_NUMBER=

# ---- Behavior tuning (optional) ----
ANNOUNCE_RECORDING=true
INTENT_HANDOFF_THRESHOLD=85
MAX_REPLY_SENTENCES=4

# ---- Embeddings (local, no API key needed) ----
# all-MiniLM-L6-v2 runs on CPU via ChromaDB's bundled ONNX runtime. The model
# (~80MB) downloads once, on first run, into ~/.cache/chroma. 384 dimensions.
# OPENAI_API_KEY=
EMBEDDING_MODEL=all-MiniLM-L6-v2
# EMBEDDING_DIMENSIONS is ignored by the local model (fixed at 384).
EMBEDDING_TIMEOUT_S=8
RAG_TOP_K=3
# Retrieval further away than this is not a match: the bot answers "I don't
# have that" instead of grounding on a random entry.
RAG_MAX_DISTANCE=1.5
